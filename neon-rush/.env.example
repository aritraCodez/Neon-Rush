# Set this on the Render STATIC SITE after deploying the arena WEB SERVICE.
# Use the actual backend address Render assigns, then rebuild the Static Site.
VITE_MULTIPLAYER_URL=https://YOUR-ARENA-SERVICE.onrender.com

# Local development needs no .env file: Vite proxies /ws to localhost:3001.

# Optional frontend command-batch send cap (10-60 messages/second).
VITE_ARENA_INPUT_RATE=30

# Set these on the backend service, not on the static frontend.
# ARENA_TICK_RATE=30       # allowed: 20, 30, 60
# ARENA_SNAPSHOT_RATE=15   # integer 5..tick rate
